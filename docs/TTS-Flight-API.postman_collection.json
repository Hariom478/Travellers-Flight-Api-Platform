      "name": "Flight (Airservice)",
      "item": [
        {
          "name": "Search",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Username", "value": "{{apiUsername}}" },
              { "key": "Password", "value": "{{apiPassword}}" }
            ],
            "url": { "raw": "{{baseUrl}}/airservice/rest/search", "host": ["{{baseUrl}}"], "path": ["airservice", "rest", "search"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"UserIp\": \"{{UserIp}}\",\n  \"Adult\": 1,\n  \"Child\": 0,\n  \"Infant\": 0,\n  \"DirectFlight\": false,\n  \"JourneyType\": 1,\n  \"PreferredCarriers\": [],\n  \"CabinClass\": 1,\n  \"Supplier\": \"\",\n  \"Sources\": \"\",\n  \"AirSegments\": [\n    {\n      \"Origin\": \"DEL\",\n      \"Destination\": \"BOM\",\n      \"PreferredTime\": \"2026-12-15\"\n    }\n  ]\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-capture the search token for the next requests in this collection",
                  "try {",
                  "    const json = pm.response.json();",
                  "    if (json.SearchTokenId) {",
                  "        pm.collectionVariables.set('SearchTokenId', json.SearchTokenId);",
                  "    }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
