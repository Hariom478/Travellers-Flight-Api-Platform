{
  "info": {
    "name": "TTS Flight API (api/ folder)",
    "_postman_id": "f1e4d2a0-1234-4abc-9def-000000000001",
    "description": "Collection built from api/app/Modules (Airservice = flight, Holidayservice = holiday). Every route under /rest/* needs the Username/Password headers (see Auth filter: api/app/Filters/Auth.php). TBOFlight/GALFlight/Indigo/CRSFlight have no public routes of their own - Airservice\\Rest dispatches to them internally based on the active supplier, so Search/FareConfirmation/Book/Ticket below cover all suppliers.\n\nFlow: Search -> FareRule/FareConfirmation -> SSR (optional) -> Book (GDS) or Ticket (LCC) -> GetBookingDetail. Every request/response is matched by SearchTokenId (from Search) and ResultIndex (from the chosen Search result), so run requests in that order and copy those two values forward.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080/api", "description": "Front controller of the api/ app. Use https://<your-domain>/api on a real server." },
    { "key": "apiUsername", "value": "", "description": "Value for the Username header - the api_username issued to a web partner (table api_webpartner_setting)." },
    { "key": "apiPassword", "value": "", "description": "Value for the Password header - the matching api_password." },
    { "key": "SearchTokenId", "value": "", "description": "Filled in automatically by the Search request's test script." },
    { "key": "ResultIndex", "value": "", "description": "Set manually after Search: pick one key from Result[].ResultIndex in the search response." },
    { "key": "BookingId", "value": "" },
    { "key": "PNR", "value": "" },
    { "key": "UserIp", "value": "1.2.3.4" }
  ],
